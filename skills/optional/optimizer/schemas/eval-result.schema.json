{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optimizer Eval Result",
  "type": "object",
  "required": [
    "schema_version",
    "overall_assessment",
    "findings",
    "recommendations"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "overall_assessment": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "confidence",
          "problem",
          "recommendation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "category": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "evidence": {
            "type": "array"
          },
          "recommendation": {
            "type": "string"
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "no_material_issue": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
