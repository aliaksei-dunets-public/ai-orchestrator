{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/memory-proposal.schema.json",
  "type": "object",
  "required": ["schema_version", "id", "kind", "content", "source", "source_digest", "confidence", "proposal_hash", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^PROP-[0-9]{4,}$"},
    "kind": {"enum": ["observation", "decision", "lesson", "instruction"]},
    "content": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "supersedes": {"type": ["string", "null"]},
    "proposal_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
