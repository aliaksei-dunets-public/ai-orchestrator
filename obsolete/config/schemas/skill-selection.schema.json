{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/skill-selection.schema.json",
  "title": "Project optional skill selection",
  "type": "object",
  "required": ["schema_version", "optional_skills"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "optional_skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    }
  }
}
