{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/memory-event.schema.json",
  "type": "object",
  "required": ["schema_version", "id", "action", "subject_id", "timestamp", "reason"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^EVT-[0-9]{4,}$"},
    "action": {"enum": ["promote", "disable", "supersede"]},
    "subject_id": {"type": "string", "minLength": 1},
    "replacement_id": {"type": ["string", "null"]},
    "proposal_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "approval_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
