{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-orchestrator/onboarding-session.schema.json",
  "title": "Agent-led Onboarding Session",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "status",
    "target_root",
    "core_root",
    "answers",
    "rollback_on_error",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "session_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "inspecting",
        "needs_input",
        "preview_ready",
        "applying",
        "validating",
        "completed",
        "rolled_back",
        "rollback_failed",
        "cancelled",
        "blocked"
      ]
    },
    "target_root": {"type": "string", "minLength": 1},
    "core_root": {"type": "string", "minLength": 1},
    "target_fingerprint": {"type": ["string", "null"]},
    "plan_hash": {"type": ["string", "null"]},
    "backup_manifest": {"type": ["string", "null"]},
    "answers": {"type": "object"},
    "rollback_on_error": {"type": "boolean"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
