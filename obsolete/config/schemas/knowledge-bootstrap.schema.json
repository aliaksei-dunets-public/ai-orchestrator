{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/knowledge-bootstrap.schema.json",
  "type": "object",
  "required": ["schema_version", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "label", "source"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "supersedes": {"type": ["string", "null"]},
          "enabled": {"type": "boolean"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_node", "target_node", "relation", "source"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_node": {"type": "string", "minLength": 1},
          "target_node": {"type": "string", "minLength": 1},
          "relation": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean"}
        }
      }
    }
  }
}
