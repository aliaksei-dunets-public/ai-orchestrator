{
  "schema_version": 1,
  "rules": [
    {
      "path_prefixes": [
        "orchestrator/cli.py",
        "orchestrator/memory_cli.py",
        "orchestrator/knowledge_cli.py",
        "orchestrator/context_cli.py",
        "orchestrator/task_cli.py",
        "orchestrator/task_manager.py",
        "orchestrator/registry_lock.py",
        "orchestrator/worktree_manager.py",
        "orchestrator/backlog.py",
        "orchestrator/execution.py",
        "workflows/backlog-loop.yaml",
        "workflows/task-execution.yaml"
      ],
      "documents": [
        "docs/specifications/orchestrator-specification-ru.md",
        "docs/specifications/task-layer-specification-ru.md",
        "docs/migrations/cli-contract.md",
        "docs/migrations/1.3-task-workspaces.md",
        "docs/adr/0003-task-workspace-execution-modes.md",
        "docs/architecture/component-contracts.md"
      ],
      "owner": "documentation-manager",
      "reason": "Public CLI contract changed."
    },
    {
      "path_prefixes": [
        "orchestrator/memory.py",
            "orchestrator/knowledge.py",
            "orchestrator/knowledge_bootstrap.py",
            "orchestrator/ontology.py",
        "orchestrator/retrieval.py",
        "orchestrator/source_authority.py",
        "orchestrator/memory_knowledge_migration.py"
      ],
      "documents": [
        "docs/specifications/orchestrator-specification-ru.md",
        "docs/specifications/task-layer-specification-ru.md",
        "docs/architecture/component-contracts.md",
        "docs/guides/deployment-to-target-project-ru.md",
        "docs/migrations/1.2.md"
      ],
      "owner": "documentation-manager",
      "reason": "Project Memory, Knowledge Graph, retrieval, or migration contract changed."
    },
    {
      "path_prefixes": ["config/schemas/", "registries/"],
      "documents": ["docs/architecture/component-contracts.md"],
      "owner": "documentation-manager",
      "reason": "Machine-readable contract changed."
    },
    {
      "path_prefixes": ["generated/"],
      "documents": ["generated/README.md"],
      "owner": "generator",
      "reason": "Generated artifacts are owned by their generator."
    }
  ]
}
