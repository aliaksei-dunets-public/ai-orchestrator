{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/approval.schema.json",
  "type": "object",
  "required": ["schema_version", "request_id", "decision", "baseline_revision", "baseline_hash", "answer", "decided_at"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["approved", "rejected", "waiting"]},
    "baseline_revision": {"type": "integer", "minimum": 1},
    "baseline_hash": {"type": "string", "minLength": 1},
    "answer": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
