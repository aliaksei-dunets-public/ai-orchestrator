{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/memory-approval.schema.json",
  "type": "object",
  "required": ["schema_version", "proposal_hash", "source_digest", "decision", "approved_by", "approved_at", "approval_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "proposal_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision": {"enum": ["approve", "reject"]},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "minLength": 1},
    "approval_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
