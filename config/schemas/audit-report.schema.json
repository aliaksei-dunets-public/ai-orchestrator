{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/audit-report.schema.json",
  "type": "object",
  "required": ["schema_version", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message", "evidence", "proposal", "fingerprint"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
          "message": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "proposal": {"type": "string", "minLength": 1},
          "fingerprint": {"type": "string", "minLength": 64}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
