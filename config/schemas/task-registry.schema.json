{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-orchestrator/task-registry.schema.json",
  "title": "Task Registry",
  "type": "object",
  "required": ["schema_version", "next_id", "tasks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "next_id": {
      "type": "integer",
      "minimum": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "context", "status_note", "created_at", "updated_at"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TASK-[0-9]{4,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["backlog", "in_progress", "waiting_user", "blocked", "done", "cancelled"]
          },
          "context": {
            "type": "string",
            "pattern": "^contexts/TASK-[0-9]{4,}\\.md$"
          },
          "status_note": {
            "type": ["string", "null"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "assignment": {
            "type": ["object", "null"],
            "required": [
              "mode",
              "run_id",
              "sequence",
              "max_workers",
              "workspace_kind",
              "workspace_path",
              "branch",
              "base_commit",
              "commit_evidence"
            ],
            "additionalProperties": false,
            "properties": {
              "mode": {"const": "isolated_parallel"},
              "run_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "sequence": {"type": "integer", "minimum": 1},
              "max_workers": {"type": "integer", "minimum": 1, "maximum": 16},
              "workspace_kind": {"enum": ["main", "worktree"]},
              "workspace_path": {"type": "string", "minLength": 1},
              "branch": {"type": ["string", "null"]},
              "base_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "commit_evidence": {
                "type": ["string", "null"],
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          },
          "finalization": {
            "type": "object",
            "required": ["receipt_hash", "changed_paths_digest", "completed_at"],
            "additionalProperties": false,
            "properties": {
              "receipt_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "changed_paths_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "completed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
