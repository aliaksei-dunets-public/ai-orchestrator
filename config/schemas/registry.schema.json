{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-orchestrator/registry.schema.json",
  "title": "AI Orchestrator registry",
  "type": "object",
  "required": ["schema_version", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "kind", "enabled"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["skill", "workflow", "profile", "template", "policy"]
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
