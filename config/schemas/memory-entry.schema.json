{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/memory-entry.schema.json",
  "type": "object",
  "required": ["schema_version", "id", "kind", "content", "source", "source_digest", "confidence", "timestamp", "enabled"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^MEM-[0-9]{4,}$"},
    "kind": {"enum": ["observation", "decision", "lesson", "instruction"]},
    "content": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "source_digest": {"type": "string", "minLength": 64},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "timestamp": {"type": "string", "minLength": 1},
    "supersedes": {"type": ["string", "null"]},
    "enabled": {"type": "boolean"}
  },
  "additionalProperties": false
}
