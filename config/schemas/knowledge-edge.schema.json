{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/knowledge-edge.schema.json",
  "type": "object",
  "required": ["schema_version", "id", "source_node", "target_node", "relation", "source"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "source_node": {"type": "string", "minLength": 1},
    "target_node": {"type": "string", "minLength": 1},
    "relation": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "enabled": {"type": "boolean"}
  },
  "additionalProperties": false
}
